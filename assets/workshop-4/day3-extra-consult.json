{
  "name": "Day 3 · Extra · Sub-agents consult each other",
  "nodes": [
    {
      "id": "64981374-7b74-42f1-8883-cdfd522cbb66",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
