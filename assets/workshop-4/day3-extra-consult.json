    {
      "id": "ae8cc167-d183-413a-ab37-92d9a84d670b",
      "name": "Customer Context Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        1056,
        432
      ],
      "parameters": {
        "toolDescription": "Use this agent to look up the customer of the ticket by customer_id: customer type, transactions per hour, previous incidents and critical.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt_User_Message', '') }}",
        "options": {
          "systemMessage": "You are a customer context sub-agent.\nLook up the customer_id you get with the Get row(s) tool.\nReturn a short note: customer name, customer type, transactions per hour, previous incidents, and critical (yes or no).\nIf no row matches, say \"customer not found\". Never guess."
        }
      }
    },
