    {
      "id": "72cbebbd-bf87-4dd3-9d92-76227bf597eb",
      "name": "Customer Reply Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        480,
        432
      ],
      "parameters": {
        "toolDescription": "Writes a customer reply draft. Before writing, it asks the Risk Agent for a risk note, so the reply matches the risk.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt_User_Message', '') }}",
        "options": {
          "systemMessage": "You are a customer support communication sub-agent.\n\nBefore you write anything, ask the Risk Agent for a short risk note on this ticket.\nUse that note.\nNever promise refunds, credits, amounts or deadlines unless explicitly supported by verified ticket or customer data.\nNever claim an action has been taken unless the workflow actually performed it.\nDo not promise or imply that you or the team will escalate, investigate, follow up, or take any other action. This workflow only drafts a reply.\nIf unsure, say so and request human review.\n\nThen write a short, friendly and professional reply.\nReturn only the customer reply. Keep the risk note internal.\nDraft only from verified facts. Never state or offer that anyone will escalate, investigate, contact the customer, send anything, issue a refund or replacement, or take any other future action. Do not give timelines. Acknowledge the issue and ask for information if needed.\nWrite at most two sentences: one acknowledgement and one direct question. End immediately after the question mark. Do not add offers, next steps, or conditional statements."
        }
      }
    },
    {
      "id": "d22f84bc-0c8d-4952-885b-ee0111d8551a",
      "name": "Reply Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        560,
        640
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        }
      }
    },
    {
      "id": "8154c6e5-66fc-4a80-a0d7-77ee89f3ce65",
      "name": "Risk Agent",
      "type": "@n8n/n8n-nodes-langchain.agentTool",
      "typeVersion": 3,
      "position": [
        768,
        432
      ],
      "parameters": {
        "toolDescription": "Use this agent to assess ticket risk, urgency and whether escalation is required.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt_User_Message', '') }}",
        "options": {
          "systemMessage": "You are a payment risk and escalation sub-agent.\n\nReview the ticket context.\n\nIdentify:\n- customer risk\n- complaint risk\n- urgency\n- whether escalation is needed\n\nReturn a short internal risk note."
        }
      }
    },
