Output "assets/day5-daily-brief-teach/a7-guide.mp4"

Set Shell "zsh"
Set FontSize 18
Set Width 1148
Set Height 780
Set TypingSpeed 18ms

Type "cd ../day5-daily-brief-maarten"
Enter
Sleep 400ms
Type "sed -n '118,130p' SOLO.md"
Enter
Sleep 7s
Type "printf '\nINSTRUCTION — You make every PASS decision.\nPROOF ACTION — inspect docs/gate.md and the PR preview.\nDo not commit, push or open the PR before the human gate.\n'"
Enter
Sleep 5s
