Output "assets/day5-daily-brief-teach/a2-guide.mp4"

Set Shell "zsh"
Set FontSize 18
Set Width 1148
Set Height 780
Set TypingSpeed 18ms

Type "cd ../day5-daily-brief-maarten"
Enter
Sleep 400ms
Type "sed -n '48,60p' SOLO.md"
Enter
Sleep 6s
Type "printf '\nINSTRUCTION — Commit the red test before the schema implementation.\nPROOF ACTION — run: npm test\nInspect the quoted spec rows, red run, green run and invalid sample.\n'"
Enter
Sleep 5s
